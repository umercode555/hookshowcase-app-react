{
  "package": {
    "productName": "Hook & Showcase",
    "version": "2.0.0"
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.hookshowcase.app",
      "targets": "all",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
      "externalBin": ["binaries/ffmpeg"],
      "resources": []
    },
    "allowlist": {
      "all": true
    },
    "windows": [
      {
        "title": "Hook & Showcase",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:hookshowcase.db"]
    }
  }
}
